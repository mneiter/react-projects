# Makefile for managing frontend tasks of a Next.js project

# ─────────────── Frontend Commands ───────────────

# Run the development server
dev:
	npm run dev

# Build the project for production
build:
	npm run build

# Start the production server (requires build)
start:
	npm run start

# Install all dependencies listed in package.json
install:
	npm install

# Lint the source code using ESLint
lint:
	npm run lint

# Format the code using Prettier
format:
	npm run format

# Run frontend unit tests using Jest
test:
	npx jest

# ─────────────── Help ───────────────

# Show help text describing available commands
help:
	@echo ""
	@echo "Frontend Makefile Commands:"
	@echo ""
	@echo "  make dev       - Run the development server"
	@echo "  make build     - Build the project for production"
	@echo "  make start     - Start the production server (requires build)"
	@echo "  make install   - Install all dependencies from package.json"
	@echo "  make lint      - Lint the source code using ESLint"
	@echo "  make format    - Format the code using Prettier"
	@echo "  make test      - Run frontend unit tests using Jest"
	@echo "  make help      - Show this help message"
	@echo ""
