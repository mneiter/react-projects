{
  "version": "0.2.0",
  "configurations": [
        {
            "type": "node",
            "name": "Debug Jest (direct)",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
            "args": [
                "--runInBand",
                "--config",
                "jest.config.mjs"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "runtimeArgs": ["--experimental-vm-modules"],
            "env": {
                "NODE_ENV": "test"
            }
        }, 
        {
            "type": "node",
            "name": "Debug Jest Test",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/jest",
            "args": [
                "--runInBand",
                "--config",
                "jest.config.mjs"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "runtimeArgs": ["--experimental-vm-modules"],
            "skipFiles": ["<node_internals>/**"],
            "env": {
                "NODE_ENV": "test"
            }
        },
        {
            "name": "Next.js: Debug client-side",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "trace": true,
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Next.js: Debug server-side",
            "type": "pwa-node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "skipFiles": ["<node_internals>/**"],
            "cwd": "${workspaceFolder}",
            "outFiles": ["${workspaceFolder}/.next/**/*.js"],
            "console": "integratedTerminal"
        },
        {
            "type": "node",            
            "request": "launch",
            "name": "Debug (Next.js)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ],
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run FastAPI (uvicorn)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/.venv/Scripts/uvicorn.exe",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to FastAPI in Docker",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}/backend/app",
                "remoteRoot": "/app/app"
                }
            ],
            "justMyCode": true
        },
        {
            "name": "Attach to Uvicorn",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}/backend/app",
                "remoteRoot": "${workspaceFolder}/backend/app"
                }
            ]
            }
    ]
}
